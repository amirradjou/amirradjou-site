---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import Section from "../components/Section.astro";
import ExperienceEntry from "../components/ExperienceEntry.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { loadProfile } from "../lib/profile";

const profile = loadProfile();
const year = new Date().getFullYear();
const terminalHost = profile.links.terminal.replace(/^https?:\/\/(www\.)?/, "").replace(/\/$/, "");
const featured = profile.projects.filter((p) => p.featured);
const side = profile.projects.filter((p) => !p.featured);
const edge = (i: number) => ((i % 3) + 1) as 1 | 2 | 3;
---

<Base profile={profile}>
  <a class="skip-link" href="#main">
    Skip to content
  </a>
  <Hero profile={profile} />

  <main id="main" class="page">
    <Section id="about" title="About">
      <p class="summary">{profile.summary}</p>
    </Section>

    <Section id="work" title="Open source and research">
      <div class="grid two">
        {featured.map((project, i) => (
          <ProjectCard project={project} edge={edge(i)} size="large" />
        ))}
      </div>
    </Section>

    <Section id="side-projects" title="Side projects">
      <div class="grid three">
        {side.map((project, i) => (
          <ProjectCard project={project} edge={edge(i + 2)} size="small" />
        ))}
      </div>
    </Section>

    <Section id="experience" title="Experience">
      {profile.experience.map((job) => (
        <ExperienceEntry job={job} />
      ))}
    </Section>

    <Section id="education" title="Education">
      <ul class="education">
        {profile.education.map((edu) => (
          <li>
            <strong>{edu.degree}</strong>
            <span class="soft">
              {edu.school}, {edu.location}
            </span>
            <span class="dates soft">
              {edu.start} to {edu.end}
            </span>
          </li>
        ))}
      </ul>
    </Section>

    <Section id="skills" title="Skills">
      <dl class="skills">
        {Object.entries(profile.skills).map(([group, items]) => (
          <div class="skill-row">
            <dt>{group}</dt>
            <dd>{items.join(", ")}</dd>
          </div>
        ))}
      </dl>
    </Section>
  </main>

  <footer class="band">
    <div class="page band-inner">
      <h2>Write to me</h2>
      <p class="mail no-print">
        <a href={`mailto:${profile.links.email}`}>{profile.links.email}</a>
      </p>
      <p class="band-links no-print">
        <a href={profile.links.linkedin} rel="me">
          LinkedIn
        </a>
        <a href={profile.links.github} rel="me">
          GitHub
        </a>
        <a href={profile.links.cv} download="Amirreza-Radjou-CV.pdf">
          CV (PDF)
        </a>
        <a href={profile.links.terminal}>The same site as a terminal: {terminalHost}</a>
      </p>
      <p class="small">{`CV last updated ${profile.cv_date}. © ${year} ${profile.name}.`}</p>
    </div>
  </footer>
</Base>

<style>
  .summary {
    max-width: var(--measure);
    font-size: clamp(1.2rem, 1.05rem + 0.5vw, 1.4rem);
    line-height: 1.5;
    font-stretch: 96%;
  }

  .grid {
    display: grid;
    gap: clamp(2.5rem, 4vw, 3.5rem) clamp(1.5rem, 3vw, 2.5rem);
  }

  .grid.two {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .grid.three {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  @media (max-width: 75rem) {
    .grid.three {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 40rem) {
    .grid.two,
    .grid.three {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .education {
    list-style: none;
    padding: 0;
  }

  .education li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    column-gap: 1.5rem;
  }

  .education li + li {
    margin-top: 1.1rem;
  }

  .education strong {
    font-weight: 620;
    grid-column: 1;
  }

  .education .soft:not(.dates) {
    grid-column: 1;
  }

  .education .dates {
    grid-column: 2;
    grid-row: 1;
    white-space: nowrap;
  }

  .skills {
    display: grid;
    gap: 0.7rem;
  }

  .skill-row {
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr);
    gap: 0.25rem 1.25rem;
    align-items: baseline;
  }

  .skill-row dt {
    font-weight: 620;
    font-size: 0.98rem;
  }

  .skill-row dd {
    margin: 0;
    max-width: var(--measure);
  }

  @media (max-width: 34rem) {
    .skill-row,
    .education li {
      grid-template-columns: minmax(0, 1fr);
    }

    .education .dates {
      grid-column: 1;
      grid-row: auto;
    }
  }

  .band {
    margin-top: clamp(4rem, 9vw, 7rem);
    background: var(--prussian);
    color: var(--on-plate);
  }

  .band-inner {
    padding-block: clamp(3rem, 7vw, 5rem);
  }

  .band h2 {
    font-size: clamp(2rem, 1.4rem + 2.4vw, 3.25rem);
    font-stretch: 125%;
    font-weight: 760;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .mail {
    margin-top: 1rem;
    font-size: clamp(1.2rem, 1rem + 0.9vw, 1.6rem);
    font-weight: 520;
    overflow-wrap: anywhere;
  }

  .band-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin-top: 1.5rem;
  }

  .small {
    margin-top: 2.5rem;
    font-size: 0.9rem;
    color: var(--on-plate-soft);
  }

  @media print {
    .summary {
      font-size: 10.5pt;
    }

    .grid.two,
    .grid.three {
      grid-template-columns: 1fr 1fr;
      gap: 0.6rem 1.2rem;
    }

    .band {
      margin-top: 1rem;
      background: none;
      color: #000;
    }

    .band h2 {
      display: none;
    }

    .band-inner {
      padding: 0;
    }

    .small {
      margin-top: 0.3rem;
      color: #333;
    }
  }
</style>
