---
import type { Experience } from "../lib/profile";

interface Props {
  job: Experience;
}

const { job } = Astro.props;
---

<article class="entry">
  <header class="entry-head">
    <div>
      <h3>{job.role}</h3>
      <p class="org">
        {job.company}, <span class="soft">{job.location}</span>
      </p>
    </div>
    <p class="dates soft">
      <time>{job.start}</time> – <time>{job.end}</time>
    </p>
  </header>
  <ul>
    {job.highlights.map((line) => (
      <li>{line}</li>
    ))}
  </ul>
</article>

<style>
  .entry + .entry {
    margin-top: 2.25rem;
  }

  .entry-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem 1.5rem;
    flex-wrap: wrap;
    margin-bottom: 0.5rem;
  }

  h3 {
    font-size: 1.3rem;
    font-stretch: 112%;
    font-weight: 660;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }

  .org {
    margin-top: 0.1rem;
    font-size: 1rem;
  }

  .dates {
    font-size: 0.95rem;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  ul {
    max-width: var(--measure);
    padding-left: 1.1rem;
    font-size: 1rem;
  }

  li + li {
    margin-top: 0.45rem;
  }

  li::marker {
    color: var(--on-soft);
  }

  @media print {
    .entry {
      break-inside: avoid;
    }

    .entry + .entry {
      margin-top: 0.7rem;
    }

    h3 {
      font-size: 11pt;
    }

    ul {
      font-size: 9.5pt;
    }

    li + li {
      margin-top: 0.1rem;
    }
  }
</style>
