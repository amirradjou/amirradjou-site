---
import type { Experience } from "../lib/profile";

interface Props {
  job: Experience;
}

const { job } = Astro.props;
---

<article class="entry">
  <header class="entry-head">
    <div>
      <h3>{job.role}</h3>
      <p class="org">
        {job.company} <span class="muted">· {job.location}</span>
      </p>
    </div>
    <p class="dates muted">
      <time>{job.start}</time> – <time>{job.end}</time>
    </p>
  </header>
  <ul>
    {job.highlights.map((line) => (
      <li>{line}</li>
    ))}
  </ul>
</article>

<style>
  .entry + .entry {
    margin-top: 1.5rem;
  }

  .entry-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem 1.5rem;
    flex-wrap: wrap;
    margin-bottom: 0.5rem;
  }

  h3 {
    font-size: 1.05rem;
    font-weight: 650;
    line-height: 1.3;
  }

  .org {
    font-size: 0.98rem;
  }

  .dates {
    font-size: 0.92rem;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  ul {
    font-size: 0.97rem;
  }

  @media print {
    .entry {
      break-inside: avoid;
    }

    .entry + .entry {
      margin-top: 0.7rem;
    }
  }
</style>
