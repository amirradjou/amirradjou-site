---
import type { Project } from "../lib/profile";

interface Props {
  project: Project;
}

const { project } = Astro.props;
const isRepo = /^https:\/\/github\.com\//.test(project.url);
const pretty = project.url.replace(/^https?:\/\/(www\.)?/, "").replace(/\/$/, "");
---

<article class="card">
  <header class="card-head">
    <h3>
      <a href={project.url}>{project.name}</a>
    </h3>
    <p class="kind muted">{project.kind}</p>
  </header>
  <p class="desc">{project.description}</p>
  {project.fact && <p class="fact">{project.fact}</p>}
  <footer class="card-foot">
    <ul class="tags" aria-label="Technologies">
      {project.tags.map((tag) => (
        <li>{tag}</li>
      ))}
    </ul>
    <a
      class="repo no-print"
      href={project.url}

      aria-label={`${project.name} on ${isRepo ? "GitHub" : "the web"}`}
    >
      {isRepo ? "Repository" : "Live demo"} ↗
    </a>
    <span class="print-only url muted">{pretty}</span>
  </footer>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1rem 1.1rem;
    border: 1px solid var(--border);
    border-radius: 0.6rem;
    background: var(--surface);
  }

  .card-head h3 {
    font-size: 1.02rem;
    font-weight: 650;
    line-height: 1.3;
  }

  .card-head a {
    color: var(--text);
    text-decoration: none;
  }

  .card-head a:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  .kind {
    font-size: 0.85rem;
    margin-top: 0.1rem;
  }

  .desc {
    font-size: 0.95rem;
  }

  .fact {
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--accent);
  }

  .card-foot {
    margin-top: auto;
    padding-top: 0.25rem;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 0.5rem 1rem;
    flex-wrap: wrap;
  }

  .tags {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .tags li {
    margin: 0;
    font-size: 0.78rem;
    padding: 0.1rem 0.5rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--muted);
    background: var(--bg);
  }

  .repo {
    font-size: 0.88rem;
    white-space: nowrap;
  }

  .url {
    font-size: 0.85rem;
  }

  @media print {
    .card {
      break-inside: avoid;
      padding: 0;
      border: none;
      gap: 0.2rem;
    }

    .tags li {
      border-color: #bbb;
      padding: 0 0.4rem;
    }
  }
</style>
