---
import type { Project } from "../lib/profile";

interface Props {
  project: Project;
  /** Which brushed edge (public/prints/edge-N.svg) masks this print, so neighbours differ. */
  edge: 1 | 2 | 3;
  /** Display width in CSS pixels at the largest layout, for `sizes`. */
  size: "large" | "small";
}

const { project, edge, size } = Astro.props;
const host = (url: string) => url.replace(/^https?:\/\/(www\.)?/, "").replace(/\/$/, "");
const sizes =
  size === "large"
    ? "(min-width: 60rem) 28rem, (min-width: 40rem) 45vw, 92vw"
    : "(min-width: 60rem) 18rem, (min-width: 40rem) 45vw, 92vw";
---

<article class:list={["project", size]}>
  <figure class="print-frame no-print">
    <img
      class="print"
      style={`--edge: url("/prints/edge-${edge}.svg")`}
      src={`/prints/${project.print}-600.webp`}
      srcset={`/prints/${project.print}-600.webp 600w, /prints/${project.print}-1200.webp 1200w`}
      sizes={sizes}
      width="1200"
      height="800"
      loading="lazy"
      decoding="async"
      alt={project.print_alt}
    />
  </figure>
  <h3>
    <a href={project.url}>{project.name}</a>
  </h3>
  {project.kind && <p class="kind soft">{project.kind}</p>}
  <p class="desc">{project.description}</p>
  {project.fact && <p class="fact">{project.fact}</p>}
  <p class="meta soft">{project.tags.join(", ")}</p>
  {project.live && (
    <p class="live no-print">
      <a href={project.live}>{project.live_label ?? "Open the live page"}</a>
    </p>
  )}
  <p class="print-only url soft">{host(project.url)}</p>
</article>

<style>
  .project {
    display: flex;
    flex-direction: column;
  }

  .print-frame {
    margin-bottom: 1.1rem;
  }

  .print {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    background: var(--prussian-deep);
    -webkit-mask: var(--edge) center / 100% 100% no-repeat;
    mask: var(--edge) center / 100% 100% no-repeat;
  }

  h3 {
    font-size: 1.3rem;
    font-stretch: 112%;
    font-weight: 680;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .large h3 {
    font-size: 1.6rem;
  }

  h3 a {
    text-decoration: none;
  }

  h3 a:hover {
    text-decoration: underline;
    text-decoration-thickness: 2px;
  }

  .kind {
    margin-top: 0.15rem;
    font-size: 0.95rem;
  }

  .desc {
    margin-top: 0.7rem;
    font-size: 1rem;
    line-height: 1.55;
  }

  .fact {
    margin-top: 0.75rem;
    padding-left: 0.85rem;
    border-left: 3px solid var(--saffron);
    font-size: 1rem;
    font-weight: 540;
    line-height: 1.45;
  }

  .small .fact,
  .small .desc {
    font-size: 0.97rem;
  }

  .meta {
    margin-top: 0.9rem;
    font-size: 0.9rem;
  }

  .live {
    margin-top: 0.2rem;
    font-size: 0.95rem;
    font-weight: 550;
  }

  @media print {
    .project {
      break-inside: avoid;
    }

    .desc,
    .fact,
    .small .desc,
    .small .fact {
      margin-top: 0.2rem;
      font-size: 9.5pt;
    }

    .fact {
      border: 0;
      padding: 0;
    }

    .meta {
      display: none;
    }

    h3,
    .large h3 {
      font-size: 11pt;
    }
  }
</style>
